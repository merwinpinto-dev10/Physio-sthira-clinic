# ============================================================
# PhysioSthira Clinic Backend — Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# ============================================================

PORT=5001
NODE_ENV=development

# --- Database & Cache (Fill in your own credentials) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/physiosthira_db
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# --- Twilio WhatsApp Configuration ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
BOOKING_NOTIFICATION_WHATSAPP=whatsapp:+919187310374
TWILIO_DRY_RUN=true
TWILIO_WHATSAPP_CONTENT_SID=

# --- Allowed Origins for CORS ---
ALLOWED_ORIGINS=https://www.physiosthira.in,https://physiosthira.in
